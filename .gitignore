# Rust
rust-engine/target/

# Go
go-daemon/deepscan-daemon
go-daemon/*.exe

# Java
java-parser/target/
*.class

# Generated protobuf code — Go stubs are committed (idiomatic for Go
# modules); Java stubs are generated at build time by protobuf-maven-plugin
# into java-parser/target/, already covered below.

# Local runtime data (models, LanceDB, IPC lockfiles, dev data dir) — never committed
.deepscan/
.deepscan-dev/
*.onnx
engine.lock
parser.lock

# Environment — .env.example and .env.dev are committed (no secrets);
# personal overrides are not.
.env
.env.local

# Local build output (packaged installers) — never committed; these are
# what the Releases page is for, not git history.
dist/

# Downloaded ONNX models cached across local packaging builds (fetched
# fresh by CI each run instead) — several hundred MB, never committed.
.model-cache/

# OS
.DS_Store
Thumbs.db
