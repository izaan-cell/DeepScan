<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v5 source for the DeepScan MSI. Built by .github/workflows/release.yml
  on windows-latest via `wix build` (WiX v3's candle/light have no Windows-only
  requirement either, but v5's `Files Include` globbing lets one entry pull in
  the whole frontend/ tree instead of listing every file by hand).

  Expects a staging directory laid out by that same workflow:
    stage/bin/deepscan-engine.exe
    stage/bin/deepscan-daemon.exe
    stage/launcher.ps1
    stage/frontend/**
    stage/lib/deepscan-parser.jar   (optional — only if java-parser was built)
    stage/jre/**                    (optional — only if a JRE was bundled)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="DeepScan"
      Manufacturer="DeepScan"
      Version="$(var.Version)"
      UpgradeCode="8f2c9b1a-6e4d-4a3b-9c7e-2d1a5b8f4c6e">

    <MajorUpgrade DowngradeErrorMessage="A newer version of DeepScan is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Standard Windows installer wizard: Welcome -> License -> Choose
         Install Directory -> Progress -> Finish, same shape as any normal
         desktop app's MSI. Requires `wix build ... -ext
         WixToolset.UI.wixext` (see .github/workflows/release.yml).

         The old WiX v3-style pattern — a bare <UIRef Id="WixUI_InstallDir"/>
         plus a separate <Property Id="WIXUI_INSTALLDIR"> — kept failing
         with WIX0094 "WixUI:WixUI_InstallDir is inaccessible due to its
         protection level" no matter which extension version was pinned.
         WiX v5's UI extension actually expects this dedicated namespaced
         element instead; the dialog set + install-directory binding are
         one declaration, not two loosely-connected ones. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\windows\license.rtf" />

    <Feature Id="Main" Title="DeepScan" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DeepScan" />
    </StandardDirectory>

    <!-- A bare <Files> directly under <Directory> has no ComponentGroup
         of its own — <ComponentGroupRef Id="AppFiles"/> above was
         referencing an id nothing ever defined (WIX0094:
         "WixComponentGroup:AppFiles could not be found"). Also,
         "stage\**" as a plain relative path had no defined base — WiX
         resolved it relative to something other than where the workflow
         actually created it (a bare `mkdir -p stage` in
         $GITHUB_WORKSPACE), so harvesting failed to find any files at
         all ("Missing directory for harvesting files"). $(var.StageDir)
         is passed in by the workflow as an absolute path, removing any
         ambiguity about what directory this is relative to. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.StageDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="3a7d5e9c-1b2f-4c8a-9d6e-5f0a3b7c8e1d">
        <Shortcut
            Id="DeepScanShortcut"
            Name="DeepScan"
            Target="[INSTALLFOLDER]launcher.ps1"
            WorkingDirectory="INSTALLFOLDER" />
        <!-- No custom icon yet — falls back to launcher.ps1's default.
             Add packaging/windows/DeepScan.ico and an <Icon>/Icon="..."
             reference here once real app-icon assets exist. -->
        <RegistryValue
            Root="HKCU"
            Key="Software\DeepScan"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
