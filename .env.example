# DeepScan environment configuration — template.
# Copy to .env for personal local overrides (gitignored, may hold machine-
# specific paths). Non-secret dev defaults live in .env.dev and ARE
# committed — there is nothing sensitive here since DeepScan is 100% local
# and makes no outbound network calls.

# development | production
DEEPSCAN_ENV=development

# Root directory for LanceDB, ONNX models, and IPC lockfiles.
DEEPSCAN_DATA_DIR=~/.deepscan

# Rust engine ports. In production these are ephemeral (negotiated at
# startup, published via engine.lock) — fixed here only to make local dev
# against a static frontend URL simple. See docs/ARCHITECTURE.md #4.
DEEPSCAN_ENGINE_GRPC_PORT=51423
DEEPSCAN_ENGINE_HTTP_PORT=51424

# Java Tika parser bridge gRPC port.
DEEPSCAN_PARSER_GRPC_PORT=51500

# trace | debug | info | warn | error
DEEPSCAN_LOG_LEVEL=info

# Comma-separated directories the Go daemon watches on startup.
DEEPSCAN_WATCH_ROOTS=~/Documents,~/Desktop
