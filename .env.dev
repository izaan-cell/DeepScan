# DeepScan — local development defaults. Committed: contains no secrets,
# only non-sensitive dev-mode config (fixed ports, verbose logging, a
# scoped-down watch root so `cargo run` / `go run .` don't try to index your
# entire home directory while iterating). Copy to `.env` and edit if you
# want personal overrides instead — `.env` is gitignored.

DEEPSCAN_ENV=development

DEEPSCAN_DATA_DIR=.deepscan-dev

DEEPSCAN_ENGINE_GRPC_PORT=51423
DEEPSCAN_ENGINE_HTTP_PORT=51424
DEEPSCAN_PARSER_GRPC_PORT=51500

DEEPSCAN_LOG_LEVEL=debug

# Scoped to the repo's sample-data dir for dev — swap for a real folder to
# test against your own files.
DEEPSCAN_WATCH_ROOTS=./sample-data
